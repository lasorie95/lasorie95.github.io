{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "블로그 미리보기",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "RemoteSigned",
        "-File", "${workspaceFolder}/scripts/blog.ps1",
        "-Mode", "Preview"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "블로그 의존성 설치",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "RemoteSigned",
        "-File", "${workspaceFolder}/scripts/blog.ps1",
        "-Mode", "Install"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
