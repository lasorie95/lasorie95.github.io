source "https://rubygems.org"
# Match the dependency set used by the published GitHub Pages site.
gem "github-pages", "= 232", group: :jekyll_plugins
gem "jekyll-include-cache", group: :jekyll_plugins

# Ruby 3 no longer bundles WEBrick; Jekyll uses it for local previews.
gem "webrick", "~> 1.9"

# Windows does not ship the IANA time zone database.
gem "tzinfo-data", platforms: [:mingw, :x64_mingw, :mswin]
